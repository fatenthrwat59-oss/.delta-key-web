local function secureWorkspace()
    for _, part in pairs(game.Workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            for _, word in pairs(keywords) do
                if name:find(word) then
                    part.CanTouch = false
                end
            end
        end
    end
end

local function applyAntiSit(char)
    local hum = char:WaitForChild("Humanoid")
    -- ...
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    -- ...
    hum.Sit = false
end

local function bypassDamage()
    local targets = {
        "NPCProjectileDamagePlayer",
        "JungleSpikeTrapDamage",
        "CheckLightningDamage",
        "DamagePlayer",
        "HurtDeerTorch",
        "RemoteKill",
        "KillRemote",
        "DamageRemote"
    }
    
    for _, name in pairs(targets) do
        local remote = remoteEvents:FindFirstChild(name) or repStorage:FindFirstChild(name)
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(-math.huge)
        end
    end

    if player.Character and player.Character:FindFirstChild("Humanoid") then
        local hum = player.Character.Humanoid
        -- ...
        if hum.Health > 0 and hum.Health < 100 then
            hum.Health = 100
        end
    end
end

player.CharacterAdded:Connect(function(char)
